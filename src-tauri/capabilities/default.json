{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Desktop capability for Study Bible Creator",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/sbc-engine",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
