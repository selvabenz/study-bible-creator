{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Bible Creator",
  "version": "0.5.0",
  "identifier": "org.bridgeconn.studybiblecreator",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "beforeDevCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": ["resources/app/**/*"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
