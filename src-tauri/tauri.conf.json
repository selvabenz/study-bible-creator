{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Bible Creator",
  "version": "0.5.1",
  "identifier": "org.bridgeconn.studybiblecreator",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "beforeDevCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "resources/app/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
